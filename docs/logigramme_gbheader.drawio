        <mxCell id="endErr" value="Fin&lt;br&gt;return 1 (erreur)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
