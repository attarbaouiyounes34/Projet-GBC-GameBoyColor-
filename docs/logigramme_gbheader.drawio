        <mxCell id="Ld" value="i ≤ 0x143 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1000" y="320" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Ld2" value="entete[i] == 0 ?&lt;br&gt;(fin du titre)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1000" y="440" width="200" height="80" as="geometry" />
        </mxCell>
