        <mxCell id="Lend" value="Titre affiché&lt;br&gt;(retour au programme)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1290" y="335" width="200" height="50" as="geometry" />
