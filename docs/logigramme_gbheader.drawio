        <mxCell id="endOk" value="Fin&lt;br&gt;return 0 (succès)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="850" width="200" height="50" as="geometry" />
