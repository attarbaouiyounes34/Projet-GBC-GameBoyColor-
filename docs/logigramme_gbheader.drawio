        <mxCell id="d3" value="0x150 octets&lt;br&gt;bien lus ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="530" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Afficher « fichier trop petit »" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="560" y="545" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Fermer le fichier&lt;br&gt;fclose(f)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="560" y="645" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Afficher le titre&lt;br&gt;(octets 0x134 à 0x143)&lt;br&gt;&lt;i&gt;voir détail à droite&lt;/i&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1">
