        <!-- ===== Détail : boucle d'affichage du titre ===== -->
        <mxCell id="t2" value="&lt;b&gt;Détail : boucle « Afficher le titre »&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="170" width="300" height="30" as="geometry" />
